  },
  "cloud_backup": {
    "provider": "夸克网盘（或自选其它）",
    "cookies": "",
    "folder_name": "你的备份文件夹名",
    "keep_sets": 7
  },
  "remote_access": {
    "tunnel": "蒲公英（或自选其它）",
    "account": ""
  }
}
